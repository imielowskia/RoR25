<div id="<%= dom_id group %>" class="w-full sm:w-auto my-5 space-y-5">
<div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-10 space-y-2">
  <div>
    <strong class="block font-medium mb-1">Nazwa:</strong>
    <%= group.nazwa %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Kierunek:</strong>
    <%= group.field.nazwa %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Przedmioty:</strong>
    <% group.courses.each do |c| %>
      <%= c.nazwa %> <br>
    <% end %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Studenci:</strong>
    <% group.students.each do |s| %>
      <%= s.imie %> <%= s.nazwisko %> <br>
    <% end %>
  </div>
</div>
</div>
