<%= form_with(model: group, class: "contents") do |form| %>
  <% if group.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(group.errors.count, "error") %> prohibited this group from being saved:</h2>

      <ul class="list-disc ml-6">
        <% group.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :nazwa %>
    <%= form.text_field :nazwa, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": group.errors[:nazwa].none?, "border-red-400 focus:outline-red-600": group.errors[:nazwa].any?}] %>
  </div>

  <div class="my-5">
    Kierunek: 
    <%= form.collection_select :field_id, Field.all, :id, :nazwa, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": group.errors[:field_id].none?, "border-red-400 focus:outline-red-600": group.errors[:field_id].any?}] %>
  </div>

  <div class="my-5">
    Przedmioty:
    <%= form.collection_check_boxes :course_ids, Course.all, :id, :nazwa, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": group.errors[:field_id].none?, "border-red-400 focus:outline-red-600": group.errors[:field_id].any?}] %>
  </div>


  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
