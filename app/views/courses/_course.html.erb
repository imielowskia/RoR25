<div id="<%= dom_id course %>" class="w-full sm:w-auto my-3 bg-blue-100 space-y-3 border border-gray-300 rounded-lg p-4">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-start">
    <!-- labels row -->
    <div>
      <strong class="block font-medium mb-1">Nazwa:</strong>
    </div>

    <div>
      <strong class="block font-medium mb-1">Ects:</strong>
    </div>

    <div>
      <strong class="block font-medium mb-1">Grupy:</strong>
    </div>

    <!-- values row -->
    <div>
      <span><%= course.nazwa %></span>
    </div>

    <div>
      <span><%= course.ects %></span>
    </div>

    <div>
      <ul class="list-none p-0 space-y-2">
        <% course.groups.each do |g| %>
          <li class="relative flex items-center justify-between mb-6 pl-6 before:content-['•'] before:absolute before:left-0">
            <span class="mr-4"><%= g.nazwa %></span>
            <%= link_to 'Oceny cząstkowe', grade_details_course_path(course.id, g.id), class: "button1 mr-2" %>
            <%= link_to 'Oceny', grade_course_path(course.id, g.id), class: "button1" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
