<div id="<%= dom_id course %>" class="w-full sm:w-auto my-3 space-y-3">

  <div>
    <strong class="block font-medium mb-1">Nazwa:</strong>
    <%= course.nazwa %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Ects:</strong>
    <%= course.ects %>
  </div>

  <div>
    <strong class="block font-medium mb-1">Grupy:</strong>
    <% course.groups.each do |g| %>
      <div class="flex items-center justify-between mb-6">
        <span class="mr-8"><%= g.nazwa %></span>
        <%= link_to 'Oceny', grade_course_path(course.id, g.id), class: "button1 inline-block ml-2" %>
      </div>
    <% end %>
  </div>

</div>
