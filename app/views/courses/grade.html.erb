<% content_for :title, "Oceny" %>

<div class="container mx-auto px-4">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-bold text-2xl sm:text-4xl mr-4"><%= @course.nazwa %> oceny dla <%= @group.nazwa %></h1>
    <%= link_to "Oceń", grade_set_path(@course.id, @group.id), class: "button0 inline-block" %>
  </div>

  <div class="mx-auto w-full max-w-4xl mt-4">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50 text-left">
          <tr>
            <th>Student</th>
            <th>Ocena</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @students.each do |s| %>
            <tr>
              <td><%= @grades[s.id]['imie'] %> <%= @grades[s.id]['nazwisko'] %></td>
              <td><%= @grades[s.id]['grade'] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="flex items-center justify-between mb-6">
    <%= link_to "Powrót do listy kursów", courses_path, class: "button0 inline-block" %>
  </div>

</div>