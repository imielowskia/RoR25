<div id="<%= dom_id student %>" class="w-full sm:w-auto my-5 space-y-5 bg-blue-100 p-5 rounded-md shadow-md">
  <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
  <div class="px-3">
    <strong class="block font-medium mb-1">Album:</strong>
    <%= student.album %>
  </div>
  <div class="px-3">
    <strong class="block font-medium mb-1">Imie:</strong>
    <%= student.imie %>
  </div>
  <div class="px-3">
    <strong class="block font-medium mb-1">Nazwisko:</strong>
    <%= student.nazwisko %>
  </div>
  <div class="px-3">
    <strong class="block font-medium mb-1">Group:</strong>
    <%= student.group.nazwa %>
  </div>
  </div>
</div>
