<% content_for :title, "Students" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Students</h1>
    <%= link_to "New student", new_student_path, class: "button0" %>
  </div>

  <div id="students" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @students.any? %>
      <% @students.each do |student| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render student %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", student, class: "button1" %>
            <%= link_to "Edit", edit_student_path(student), class: "button1" %>
            <%= button_to "Destroy", student, method: :delete, class: "button2", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No students found.</p>
    <% end %>
  </div>
</div>
